# Claude Code — local-only files
# settings.local.json holds machine-specific Claude Code configuration
.claude/settings.local.json
.claude/planner_config.toml

# Agent memory (memory: local) — each developer builds their own
# Covers: architect-reviewer, code-reviewer, security-reviewer
.claude/agent-memory-local/

# Claude Code session transcripts and cache
.claude/projects/
.claude/todos/

# Generated task slice plans (keyed by content hash — local to each run)
.claude/task-slices/

# Python
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
